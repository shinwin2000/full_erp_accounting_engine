# ============================================================
# .env.example
# ERP Accounting Engine — Template Environment Variables
#
# CARA PAKAI:
#   1. Salin file ini: cp .env.example .env
#   2. Isi semua nilai yang diperlukan
#   3. JANGAN commit file .env ke repository
#
# Keterangan:
#   [WAJIB]   = sistem tidak bisa start tanpa nilai ini
#   [OPSIONAL] = fitur tertentu tidak aktif tanpa nilai ini
# ============================================================

# ── Identitas Aplikasi ───────────────────────────────────────
# [WAJIB]
APP_ENV=development
# development | staging | production

APP_NAME=ERP Accounting Engine
APP_VERSION=2.0.0
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Server ──────────────────────────────────────────────────
# [OPSIONAL] — default dipakai kalau tidak di-set
HOST=127.0.0.1
PORT=8000
WORKERS=1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database PostgreSQL ──────────────────────────────────────
# [WAJIB]
# config/loader_yaml.py + infrastructure/database/session_factory_sqlalchemy.py
DATABASE_URL=postgresql+asyncpg://erp_user:erp_password@localhost:5432/erp_accounting_db
DATABASE_SYNC_URL=postgresql+psycopg2://erp_user:erp_password@localhost:5432/erp_accounting_db

# Read replica (opsional — untuk CQRS query)
# infrastructure/database/read_replica_router.py
DATABASE_READ_REPLICA_URL=postgresql+asyncpg://erp_readonly:readonly_password@localhost:5433/erp_accounting_db

# Pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ── Redis ────────────────────────────────────────────────────
# [WAJIB]
# infrastructure/caching/redis_manager.py
# kernel/distributed_lock_redis.py
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# Redis untuk Celery (task queue)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Secret Keys ──────────────────────────────────────────────
# [WAJIB]
# infrastructure/security/jwt_issuer.py
SECRET_KEY=GANTI-DENGAN-256-BIT-SECRET-KEY-YANG-KUAT-DAN-RANDOM
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption key (AES-256) — untuk field-level encryption
# infrastructure/security/field_encryption_aes256_gcm.py
FIELD_ENCRYPTION_KEY=GANTI-DENGAN-32-BYTE-BASE64-ENCODED-KEY

# ── Kafka ────────────────────────────────────────────────────
# [OPSIONAL] — event streaming, outbox relay
# infrastructure/message_broker/
# adapters/secondary_impl/kafka_event_publisher_impl.py
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Topic names
KAFKA_TOPIC_ACCOUNTING_EVENTS=erp.accounting.events
KAFKA_TOPIC_AUDIT_EVENTS=erp.audit.events
KAFKA_TOPIC_TAX_EVENTS=erp.tax.events
KAFKA_TOPIC_DEAD_LETTER=erp.dead.letter

# ── HashiCorp Vault ──────────────────────────────────────────
# [OPSIONAL] — secret management
# config/vault_integrator.py
# infrastructure/security/vault_dynamic_secret_provider.py
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SECRET_PATH=secret/erp

# ── Coretax DJP ─────────────────────────────────────────────
# [OPSIONAL] — integrasi pajak DJP
# adapters/coretax_djp/api_oauth2_client.py
CORETAX_API_BASE_URL=https://preprod.coretaxdjp.pajak.go.id
CORETAX_CLIENT_ID=
CORETAX_CLIENT_SECRET=
CORETAX_NPWP_PEMUNGUT=
CORETAX_TIMEOUT_SECONDS=30
CORETAX_MAX_RETRIES=3

# ── MinIO / S3 ───────────────────────────────────────────────
# [OPSIONAL] — penyimpanan dokumen dan evidence
# infrastructure/file_storage/
# adapters/secondary_impl/minio_evidence_store.py
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_EVIDENCE=erp-evidence
MINIO_BUCKET_REPORTS=erp-reports

# AWS S3 (jika pakai S3 bukan MinIO)
# adapters/secondary_impl/s3_file_storage_adapter_impl.py
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=erp-accounting-evidence

# AWS Glacier (cold storage arsip)
# adapters/secondary_impl/glacier_cold_storage_adapter.py
AWS_GLACIER_VAULT_NAME=erp-accounting-archive

# ── Notifikasi Email ─────────────────────────────────────────
# [OPSIONAL]
# adapters/secondary_impl/email_smtp_notification.py
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@erp.example.com
SMTP_FROM_NAME=ERP Accounting Engine

# ── WhatsApp Business ────────────────────────────────────────
# [OPSIONAL]
# adapters/secondary_impl/whatsapp_business_notification.py
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Slack ────────────────────────────────────────────────────
# [OPSIONAL]
# adapters/secondary_impl/slack_alert_adapter.py
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=#erp-alerts
SLACK_AUDIT_CHANNEL=#erp-audit

# ── PagerDuty ────────────────────────────────────────────────
# [OPSIONAL] — incident management
# adapters/secondary_impl/pagerduty_incident_adapter.py
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=

# ── Observability — Jaeger / OTLP ───────────────────────────
# [OPSIONAL]
# infrastructure/telemetry/opentelemetry_setup.py
# infrastructure/telemetry/jaeger_exporter.py
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=erp-accounting-engine
OTEL_ENVIRONMENT=development

# ── Sentry (error tracking) ──────────────────────────────────
# [OPSIONAL]
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Bank API ────────────────────────────────────────────────
# [OPSIONAL] — rekonsiliasi bank otomatis
# adapters/secondary_impl/bank_api_payments_adapter.py
BANK_API_BASE_URL=
BANK_API_CLIENT_ID=
BANK_API_CLIENT_SECRET=
BANK_API_TIMEOUT=30

# ── RFC 3161 Timestamping ────────────────────────────────────
# [OPSIONAL] — cap waktu kriptografis untuk dokumen audit
# adapters/secondary_impl/rfc3161_timestamp_adapter.py
RFC3161_TSA_URL=https://freetsa.org/tsr
RFC3161_TSA_CERT=

# ── HSM (Hardware Security Module) ──────────────────────────
# [OPSIONAL] — penandatanganan digital grade enterprise
# security_hardening/hsm_pkcs11_manager.py
HSM_LIB_PATH=/usr/lib/softhsm/libsofthsm2.so
HSM_SLOT_ID=0
HSM_TOKEN_PIN=

# ── Multi-tenancy / Legal Entity ─────────────────────────────
# [WAJIB] jika sistem digunakan untuk satu perusahaan
# domain/legal_entity/aggregate_root.py
DEFAULT_LEGAL_ENTITY_ID=
DEFAULT_CURRENCY=IDR
DEFAULT_LOCALE=id_ID
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_FISCAL_YEAR_START_MONTH=1
# 1 = Januari, 7 = Juli (fiscal year mulai Juli)

# ── Feature Flags ────────────────────────────────────────────
# config_files/feature_flags.yaml juga bisa digunakan
FEATURE_CORETAX_INTEGRATION=false
FEATURE_FOREX_REVALUATION=false
FEATURE_CONSOLIDATION=false
FEATURE_MANUFACTURING=false
FEATURE_PROJECT_SERVICES=false
FEATURE_UMKM_MODE=false
FEATURE_AML_SCREENING=true
FEATURE_AUDIT_HASH_CHAIN=true
FEATURE_EVENT_SOURCING=true

# ── Materialitas & Audit ─────────────────────────────────────
# compliance/ethics/materiality_threshold_quantitative.py
# audit/sampling_materiality/
MATERIALITY_THRESHOLD_QUANTITATIVE=50000000
# Nilai transaksi (IDR) di atas ini dianggap material
MATERIALITY_THRESHOLD_PERCENTAGE=0.05
# 5% dari total aset / pendapatan

# ── Kebijakan Keamanan ───────────────────────────────────────
# security_hardening/password_policy_enforcer.py
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
SESSION_TIMEOUT_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
MFA_REQUIRED=false

# ── Rate Limiting ────────────────────────────────────────────
# adapters/primary_api/common/fastapi_rate_limit_middleware.py
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=2000

# ── Audit & Retensi Data ─────────────────────────────────────
# config_files/audit_retention_policy.yaml
AUDIT_LOG_RETENTION_YEARS=10
DOCUMENT_RETENTION_YEARS=10
EVENT_STORE_RETENTION_YEARS=10
COLD_STORAGE_AFTER_YEARS=5

# ── mTLS ────────────────────────────────────────────────────
# [OPSIONAL] — mutual TLS untuk layanan internal
# infrastructure/security/mtls_certificate_loader.py
MTLS_CA_CERT_PATH=
MTLS_CLIENT_CERT_PATH=
MTLS_CLIENT_KEY_PATH=

# ── Disaster Recovery ────────────────────────────────────────
# disaster_recovery/
DR_BACKUP_S3_BUCKET=erp-accounting-backup
DR_BACKUP_ENCRYPTION_KEY=
DR_RTO_TARGET_HOURS=4
DR_RPO_TARGET_HOURS=1
