#!/usr/bin/env python3
"""
Module: sqlalchemy_audit_event_adapter.py
Layer: Adapters (Secondary Implementation)
Responsibility: Real SQLAlchemy implementation of AuditRepositoryPort.

This adapter implements the AuditRepositoryPort contract using an
append-only table with hash chaining for integrity verification.
It also provides legacy methods (log_event, get_events) for backward compatibility.
"""

from __future__ import annotations

import hashlib
import json
import logging
import uuid
from datetime import datetime
from typing import Any
from uuid import UUID

from sqlalchemy import JSON, Column, DateTime, Integer, String, and_, asc, desc, func, select
from sqlalchemy.dialects.postgresql import UUID as PGUUID
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import declarative_base

# Import port definitions
from ports.primary.audit_repository_port import AuditEvent, AuditRepositoryPort

logger = logging.getLogger(__name__)

Base = declarative_base()


class AuditEventTable(Base):
    """
    SQLAlchemy ORM model for audit events.
    Stores append-only events with hash chaining for audit integrity.
    """
    __tablename__ = "audit_events"

    id = Column(PGUUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
    aggregate_id = Column(PGUUID(as_uuid=True), nullable=False, index=True)
    # Legacy field, kept for compatibility
    entity_id = Column(String(100), nullable=True)
    event_type = Column(String(50), nullable=False)
    payload = Column(JSON, nullable=True)
    created_at = Column(DateTime(timezone=True), nullable=False, default=datetime.utcnow)
    user_id = Column(String(100), nullable=True)
    correlation_id = Column(String(100), nullable=True, index=True)
    sequence_number = Column(Integer, nullable=False, default=1)
    previous_hash = Column(String(128), nullable=True)
    hash_value = Column(String(128), nullable=True, index=True)
    event_version = Column(Integer, nullable=False, default=1)


class SQLAlchemyAuditEventAdapter(AuditRepositoryPort):
    """
    SQLAlchemy implementation of the AuditRepositoryPort.
    Uses AuditEventTable for storage and supports hash chain verification.
    """

    def __init__(self, session: AsyncSession | None = None):
        self._session = session

    async def _get_session(self) -> AsyncSession:
        """Get the current async session, creating one if needed."""
        if self._session is None:
            from infrastructure.database.session_factory_sqlalchemy import get_async_session
            self._session = await get_async_session()
        return self._session

    # ========================================================================
    # Port Methods (AuditRepositoryPort)
    # ========================================================================

    async def append_event(self, event: AuditEvent) -> None:
        """
        Append an immutable audit event to the event store with hash chaining.
        """
        session = await self._get_session()

        # Determine next sequence number
        stmt = (
            select(func.max(AuditEventTable.sequence_number))
            .where(AuditEventTable.aggregate_id == event.aggregate_id)
        )
        result = await session.execute(stmt)
        max_seq = result.scalar() or 0
        next_seq = max_seq + 1

        # Get previous hash (if any)
        previous_hash = None
        if max_seq > 0:
            prev_stmt = (
                select(AuditEventTable.hash_value)
                .where(
                    AuditEventTable.aggregate_id == event.aggregate_id,
                    AuditEventTable.sequence_number == max_seq
                )
            )
            prev_result = await session.execute(prev_stmt)
            previous_hash = prev_result.scalar()

        # Compute hash for this event
        hash_input = {
            "aggregate_id": str(event.aggregate_id),
            "event_type": event.event_type,
            "payload": event.payload,
            "sequence": next_seq,
            "previous_hash": previous_hash,
            "timestamp": event.occurred_at.isoformat(),
        }
        hash_str = json.dumps(hash_input, sort_keys=True, separators=(",", ":"))
        hash_value = hashlib.sha256(hash_str.encode("utf-8")).hexdigest()

        # Create ORM record
        record = AuditEventTable(
            aggregate_id=event.aggregate_id,
            entity_id=str(event.aggregate_id),  # for backward compatibility
            event_type=event.event_type,
            payload=event.payload,
            created_at=event.occurred_at,
            user_id=str(event.user_id) if event.user_id else None,
            correlation_id=event.correlation_id,
            sequence_number=next_seq,
            previous_hash=previous_hash,
            hash_value=hash_value,
            event_version=event.version,
        )
        session.add(record)
        await session.flush()

        logger.info(
            "Appended event %s for aggregate %s at seq %s",
            event.event_type, event.aggregate_id, next_seq
        )

    async def get_events_by_aggregate(
        self, aggregate_id: UUID, from_version: int | None = None, limit: int = 1000
    ) -> list[AuditEvent]:
        """
        Retrieve all events for a given aggregate, ordered by version (sequence).
        """
        session = await self._get_session()
        conditions = [AuditEventTable.aggregate_id == aggregate_id]
        if from_version is not None:
            conditions.append(AuditEventTable.sequence_number >= from_version)

        stmt = (
            select(AuditEventTable)
            .where(and_(*conditions))
            .order_by(asc(AuditEventTable.sequence_number))
            .limit(limit)
        )
        result = await session.execute(stmt)
        rows = result.scalars().all()
        return [self._to_domain(row) for row in rows]

    async def get_events_by_type(
        self,
        event_type: str,
        from_date: datetime | None = None,
        to_date: datetime | None = None,
        limit: int = 1000,
    ) -> list[AuditEvent]:
        """
        Retrieve events by type with optional date range.
        """
        session = await self._get_session()
        conditions = [AuditEventTable.event_type == event_type]
        if from_date is not None:
            conditions.append(AuditEventTable.created_at >= from_date)
        if to_date is not None:
            conditions.append(AuditEventTable.created_at <= to_date)

        stmt = (
            select(AuditEventTable)
            .where(and_(*conditions))
            .order_by(asc(AuditEventTable.created_at))
            .limit(limit)
        )
        result = await session.execute(stmt)
        rows = result.scalars().all()
        return [self._to_domain(row) for row in rows]

    async def get_events_by_correlation_id(self, correlation_id: str) -> list[AuditEvent]:
        """
        Retrieve events belonging to a correlation chain.
        """
        session = await self._get_session()
        stmt = (
            select(AuditEventTable)
            .where(AuditEventTable.correlation_id == correlation_id)
            .order_by(asc(AuditEventTable.created_at))
        )
        result = await session.execute(stmt)
        rows = result.scalars().all()
        return [self._to_domain(row) for row in rows]

    async def get_last_event(self, aggregate_id: UUID) -> AuditEvent | None:
        """
        Get the latest event (highest version) for an aggregate.
        """
        session = await self._get_session()
        stmt = (
            select(AuditEventTable)
            .where(AuditEventTable.aggregate_id == aggregate_id)
            .order_by(desc(AuditEventTable.sequence_number))
            .limit(1)
        )
        result = await session.execute(stmt)
        row = result.scalar_one_or_none()
        if row is None:
            return None
        return self._to_domain(row)

    async def verify_hash_chain(self, aggregate_id: UUID) -> bool:
        """
        Verify the integrity of the hash chain for an aggregate.
        Returns True if chain is intact, False otherwise.
        """
        events = await self.get_events_by_aggregate(aggregate_id, limit=10000)
        if not events:
            return True  # No events => chain is valid (empty)

        previous_hash = None
        for i, event in enumerate(events):
            # Recompute hash
            hash_input = {
                "aggregate_id": str(aggregate_id),
                "event_type": event.event_type,
                "payload": event.payload,
                "sequence": i + 1,  # sequence = 1-based index
                "previous_hash": previous_hash,
                "timestamp": event.occurred_at.isoformat(),
            }
            hash_str = json.dumps(hash_input, sort_keys=True, separators=(",", ":"))
            computed = hashlib.sha256(hash_str.encode("utf-8")).hexdigest()

            # Compare with stored hash_value (need to fetch from DB)
            # We don't have hash_value in AuditEvent, so we need to fetch from DB again
            # But we have the sequence; let's fetch from DB to compare
            # Actually this is inefficient; but for verification we can query each event
            # Simpler: retrieve from DB and compare sequence
            stored_event = await self._get_event_by_aggregate_and_sequence(
                aggregate_id, i + 1
            )
            if stored_event is None:
                return False
            if stored_event.hash_value != computed:
                return False
            previous_hash = computed
        return True

    async def _get_event_by_aggregate_and_sequence(
        self, aggregate_id: UUID, sequence: int
    ) -> AuditEventTable | None:
        """Helper to fetch a single event by aggregate and sequence."""
        session = await self._get_session()
        stmt = (
            select(AuditEventTable)
            .where(
                AuditEventTable.aggregate_id == aggregate_id,
                AuditEventTable.sequence_number == sequence,
            )
        )
        result = await session.execute(stmt)
        return result.scalar_one_or_none()

    async def get_hash_chain_root(self, aggregate_id: UUID) -> str | None:
        """
        Get the current root hash (hash of the latest event) of the aggregate's event chain.
        """
        last = await self.get_last_event(aggregate_id)
        if last is None:
            return None
        # Fetch the stored hash from DB
        session = await self._get_session()
        stmt = (
            select(AuditEventTable.hash_value)
            .where(
                AuditEventTable.aggregate_id == aggregate_id,
                AuditEventTable.sequence_number == last.version,  # version = sequence
            )
            .order_by(desc(AuditEventTable.sequence_number))
            .limit(1)
        )
        result = await session.execute(stmt)
        return result.scalar()

    async def replay_events(
        self,
        aggregate_id: UUID,
        from_version: int | None = None,
        to_version: int | None = None,
    ) -> list[AuditEvent]:
        """
        Replay events for event sourcing (returns events in order).
        """
        events = await self.get_events_by_aggregate(
            aggregate_id,
            from_version=from_version,
            limit=10000
        )
        if to_version is not None:
            events = [e for e in events if e.version <= to_version]
        return events

    # ========================================================================
    # Mapping Helpers
    # ========================================================================

    def _to_domain(self, row: AuditEventTable) -> AuditEvent:
        """
        Convert ORM row to domain AuditEvent.
        """
        # Map user_id (stored as string) back to UUID if possible
        user_id = None
        if row.user_id:
            try:
                user_id = UUID(row.user_id)
            except ValueError:
                pass

        return AuditEvent(
            event_id=row.id,
            aggregate_id=row.aggregate_id,
            event_type=row.event_type,
            payload=row.payload or {},
            occurred_at=row.created_at,
            user_id=user_id,
            correlation_id=row.correlation_id,
            causation_id=None,  # Not stored in this table
            version=row.sequence_number,  # sequence_number used as version
            hash_chain_previous=row.previous_hash,
            hash_chain_current=row.hash_value,
        )

    # ========================================================================
    # Legacy Methods (Backward Compatibility)
    # ========================================================================

    async def log_event(self, event: dict[str, Any]) -> dict[str, Any]:
        """
        Legacy method – logs an event with minimal fields.
        For backward compatibility; consider using append_event instead.
        """
        session = await self._get_session()
        audit = AuditEventTable(
            entity_id=event.get("entity_id", "unknown"),
            event_type=event.get("type", "unknown"),
            payload=event.get("payload"),
            user_id=event.get("user_id"),
        )
        session.add(audit)
        await session.flush()
        return {
            "id": str(audit.id),
            "entity_id": audit.entity_id,
            "event_type": audit.event_type,
            "payload": audit.payload,
            "created_at": audit.created_at.isoformat(),
            "user_id": audit.user_id,
        }

    async def get_events(self, entity_id: str, limit: int = 100) -> list[dict[str, Any]]:
        """
        Legacy method – retrieves events by entity_id.
        """
        session = await self._get_session()
        stmt = (
            select(AuditEventTable)
            .where(AuditEventTable.entity_id == entity_id)
            .order_by(desc(AuditEventTable.created_at))
            .limit(limit)
        )
        result = await session.execute(stmt)
        rows = result.scalars().all()
        return [
            {
                "id": str(row.id),
                "entity_id": row.entity_id,
                "event_type": row.event_type,
                "payload": row.payload,
                "created_at": row.created_at.isoformat(),
                "user_id": row.user_id,
            }
            for row in rows
        ]


# Alias for backward compatibility
SQLAlchemyAuditEventAdapterProtocol = SQLAlchemyAuditEventAdapter

__all__ = [
    "AuditEventTable",
    "SQLAlchemyAuditEventAdapter",
    "SQLAlchemyAuditEventAdapterProtocol",
]