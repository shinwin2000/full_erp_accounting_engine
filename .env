# ============================================
# ERP ACCOUNTING ENGINE - ENVIRONMENT VARIABLES
# ============================================
# Gunakan file ini untuk development.
# Untuk production, sesuaikan nilai endpoint, credentials, dan flags.
# ============================================

# ------------------- APLIKASI -------------------
APP_ENV=development
DEBUG=false
LOG_LEVEL=WARNING
WORKERS=4
SECRET_KEY=qm2x53TbHbdPpIquj4NBAkAHJSbFQBV0gWgUtb88kTo
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ------------------- DATABASE (WAJIB) -------------------
# GANTI credentials ini sebelum production!
DATABASE_URL=postgresql+asyncpg://${DB_USER:-postgres}:${DB_PASSWORD:-palapapls88}@${DB_HOST:-127.0.0.1}:${DB_PORT:-5432}/${DB_NAME:-erp_db}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false
DB_ISOLATION_LEVEL=READ COMMITTED

# ------------------- REDIS (WAJIB) -------------------
REDIS_URL=redis://${REDIS_HOST:-localhost}:${REDIS_PORT:-6379}/${REDIS_DB:-0}
REDIS_PASSWORD=${REDIS_PASSWORD:-}
REDIS_SSL=false

# ------------------- KAFKA (NONAKTIF UNTUK DEVELOPMENT SEDERHANA) -------------------
ENABLE_KAFKA=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=erp-accounting-engine
KAFKA_TOPIC_JOURNAL=erp.journal.posted
KAFKA_TOPIC_AUDIT=erp.audit.events
KAFKA_TOPIC_CORETAX=erp.tax.coretax
KAFKA_GROUP_ID=erp-engine-group

# ------------------- MINIO (NONAKTIF UNTUK DEVELOPMENT SEDERHANA) -------------------
ENABLE_MINIO=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=erp-evidence
MINIO_SECURE=false

# ------------------- JAEGER / TRACING (NONAKTIF UNTUK DEVELOPMENT SEDERHANA) -------------------
ENABLE_JAEGER=true
JAEGER_AGENT_HOST=localhost
JAEGER_HOST=localhost
JAEGER_OTLP_PORT=4317

# ------------------- VAULT (NONAKTIF) -------------------
ENABLE_VAULT=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dummy-vault-token-for-dev
VAULT_MOUNT_PATH=secret
VAULT_KV_VERSION=v2

# ------------------- CORETAX DJP (NONAKTIF) -------------------
ENABLE_CORETAX=false
CORETAX_API_BASE_URL=https://api.coretax.pajak.go.id/sandbox
CORETAX_CLIENT_ID=dummy-client-id
CORETAX_CLIENT_SECRET=dummy-client-secret
CORETAX_API_TIMEOUT=30
CORETAX_RETRY_ATTEMPTS=3

# ------------------- SENTRY (NONAKTIF) -------------------
ENABLE_SENTRY=false
SENTRY_DSN=https://dummy-sentry-dsn@sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------- SMTP (NONAKTIF) -------------------
ENABLE_SMTP=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@erp.com

# ------------------- WHATSAPP (NONAKTIF) -------------------
ENABLE_WHATSAPP=false
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------- SLACK / PAGERDUTY (NONAKTIF) -------------------
ENABLE_SLACK=false
SLACK_WEBHOOK_URL=
ENABLE_PAGERDUTY=false
PAGERDUTY_INTEGRATION_KEY=

# ------------------- ENCRYPTION & HSM (NONAKTIF) -------------------
ENABLE_HSM=false
ENCRYPTION_MASTER_KEY=change-this-in-production-32-bytes-hex
HSM_PKCS11_LIBRARY_PATH=
HSM_SLOT_ID=0
HSM_PIN=

# ------------------- PERIOD & SCHEDULER -------------------
DEFAULT_FISCAL_YEAR_START_MONTH=1
DEFAULT_PERIOD_CLOSE_DAY=25
SCHEDULER_TIMEZONE=Asia/Jakarta

# ------------------- PERFORMANCE & LIMITS -------------------
MAX_JOURNAL_LINES_PER_ENTRY=500
MAX_PAGINATION_LIMIT=1000
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_DAY=10000

# ------------------- AUDIT & RETENTION -------------------
AUDIT_EVENT_RETENTION_DAYS=2555
FINANCIAL_DATA_RETENTION_YEARS=10
HASH_CHAIN_STORAGE=postgres

# ------------------- TESTING -------------------
TESTING_MOCK_CORETAX=true
TESTING_MOCK_BANK=false
TESTING_MOCK_KAFKA=true


BACKUP_DIR=/var/backups/erp
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_BUCKET=erp-backup